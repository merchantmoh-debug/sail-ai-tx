# Allow only submission materials and generic validation tools.
/*
!/.gitignore
!/README.md
!/inputs/
!/tools/
!/tests/
!/.github/
!/reports.json
!/system_description.txt
!/.gitattributes

/inputs/*
!/inputs/patients.json
!/inputs/report_template.md
!/inputs/provenance.json
/tools/*
!/tools/validate.mjs
/tests/*
!/tests/validate.test.mjs
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/validate.yml

**/.env
**/.env.*
**/node_modules/
**/__pycache__/
